#!/bin/bash
set -e

echo "Setting up devcontainer..."

# Get the workspace directory (where this script is located)
WORKSPACE_DIR="${WORKSPACE_DIRECTORY:-$(pwd)}"
ADDONS_DIR="/mnt/supervisor/addons/local"

# Ensure the addons directory exists
mkdir -p "$ADDONS_DIR"

# Copy SimpleScheduler addon to the addons directory if it exists in workspace
if [ -d "$WORKSPACE_DIR/SimpleScheduler" ]; then
    echo "Copying SimpleScheduler addon to $ADDONS_DIR/SimpleScheduler..."
    # Remove existing copy if it exists
    rm -rf "$ADDONS_DIR/SimpleScheduler"
    # Copy the addon
    cp -r "$WORKSPACE_DIR/SimpleScheduler" "$ADDONS_DIR/SimpleScheduler"
    echo "SimpleScheduler addon copied successfully."
else
    echo "Warning: SimpleScheduler directory not found in workspace at $WORKSPACE_DIR/SimpleScheduler"
fi

# Patch supervisor_run to inject devcontainer patches as volume mounts.
# This ensures the firewall and API patches are active from first supervisor boot,
# avoiding the docker_gateway_unprotected health block.
echo "Patching supervisor_run..."
sudo sed -i "s|-v /etc/machine-id:/etc/machine-id:ro \\\\|-v /etc/machine-id:/etc/machine-id:ro \\\\\n        -v \"\${WORKSPACE_DIRECTORY:-$WORKSPACE_DIR}/supervisor_firewall_patch.py:/usr/src/supervisor/supervisor/host/firewall.py:ro\" \\\\|" /usr/bin/supervisor_run
grep -q "supervisor_firewall_patch" /usr/bin/supervisor_run && echo "supervisor_run patched OK" || echo "WARNING: supervisor_run patch failed"

echo "Devcontainer setup complete."



